# Backend host. Used by the Vite dev proxy (see vite.config.ts), not by the
# app directly. The API docs say 8080 but the real port is 8081.
VITE_BASE_PROTOCOL=https
VITE_BASE_DOMAIN=dev.xlearnedu.com
VITE_BASE_PORT=8081
VITE_BASE_PATH=/api

# Relative on purpose. The browser hits the Vite dev server, which proxies to
# the host above, so requests are same-origin. Making these absolute again
# bypasses the proxy and login breaks: the backend duplicates its
# Access-Control-Allow-Origin header, and the SameSite=Lax refresh cookie is
# not sent cross-site.
VITE_API_DOMAIN_NAME=${VITE_BASE_PATH}
VITE_PROFILE_API_DOMAIN_NAME=${VITE_BASE_PATH}
VITE_PROFILE_API_AVATAR_DOMAIN_NAME=${VITE_BASE_PATH}
VITE_SIGNUP_API_DOMAIN_NAME=${VITE_BASE_PATH}
VITE_CHAT_API_DOMAIN_NAME=${VITE_BASE_PATH}
VITE_COURSE_API_DOMAIN_NAME=${VITE_BASE_PATH}
VITE_TOKEN_CHECK_API_DOMAIN_NAME=${VITE_BASE_PATH}
VITE_ANNOUNCEMENT_API_DOMAIN_NAME=${VITE_BASE_PATH}
VITE_ASSIGNMENT_API_DOMAIN_NAME=${VITE_BASE_PATH}
VITE_CALENDAR_API_DOMAIN_NAME=${VITE_BASE_PATH}
VITE_GROUPING_API_DOMAIN_NAME=${VITE_BASE_PATH}


VITE_STATIC_BASE_URL=${VITE_BASE_PROTOCOL}://${VITE_BASE_DOMAIN}

VITE_ROCKETCHAT_BASE_URL=https://dev.chat.xlearnedu.com

# The browser calls the AI Agent through the frontend origin. Vite forwards
# this path to the API-only service so dev:8084 never makes a cross-origin
# request to :8083.
VITE_AI_AGENT_API_DOMAIN_NAME=/ai-agent
VITE_AI_AGENT_TARGET=https://dev.xlearnedu.com:8083
